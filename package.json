{
  "name": "gacha-modeller",
  "private": true,
  "version": "1.1.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3018 --host=127.0.0.1 --strictPort",
    "start": "node --experimental-transform-types scripts/server.ts",
    "project:create": "node --experimental-transform-types scripts/create-project.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=3018 --host=127.0.0.1 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "benchmark": "node --experimental-transform-types scripts/benchmark.ts",
    "lint:ui": "node scripts/check-ui.mjs",
    "lint:ui:page": "lintapple http://127.0.0.1:3018 --ready .model-details"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "lintapple": "^0.1.20",
    "playwright": "^1.63.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
