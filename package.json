{
  "name": "gacha-modeller",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3018 --host=0.0.0.0 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port=3018 --host=0.0.0.0 --strictPort",
